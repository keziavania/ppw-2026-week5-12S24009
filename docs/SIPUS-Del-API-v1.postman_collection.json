{
  "info": {
    "name": "SIPUS-Del-API-v1",
    "description": "Praktikum PPW Minggu 9. Variabel token harus dikosongkan sebelum ekspor/commit. Jalankan login untuk mengisi token pada sesi Postman Anda. Perbarui buku_id/peminjaman_id sesuai hasil request. Jangan commit kredensial atau token asli. Collection ini berisi skenario positif dan negatif; beberapa request mengubah database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login - 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "description": "SIPUS-Del PPW Minggu 9; jalankan dengan Laravel lokal.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pustakawan@del.ac.id\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "if (response.data && response.data.access_token) { pm.collectionVariables.set(\"token\", response.data.access_token); }",
                  "pm.test(\"Token diterbitkan\", function () { pm.expect(response.data.access_token).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
